# Copia este archivo como .env y ajusta los valores.
# En Hostinger: DB_HOST suele ser 127.0.0.1 o localhost.
# DB_NAME y DB_USER llevan el prefijo asignado por Hostinger (ej: u123456789_cartilla).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cartilla
DB_USER=root
DB_PASS=

APP_TZ=America/Bogota
# Déjalo en 0 en producción (Hostinger)
APP_DEBUG=0

# Contraseña del super administrador (mínimo 8 caracteres).
SUPERADMIN_CLAVE=
