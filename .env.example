# Copia este archivo como .env y ajusta los valores.
# IMPORTANTE PARA HOSTINGER:
# 1. DB_HOST debe ser 'localhost' o '127.0.0.1' (NUNCA pongas https:// ni el link de tu web).
# 2. DB_NAME y DB_USER deben llevar el prefijo completo de Hostinger (ej: u336988965_cartilla).
# 3. DB_PASS es la contraseña exacta que le diste al usuario en MySQL.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=cartilla
DB_USER=root
DB_PASS=

APP_TZ=America/Bogota
APP_DEBUG=0

# Contraseña del super administrador (mínimo 8 caracteres)
SUPERADMIN_CLAVE=Demo2026!
