# Copia este archivo como .env y ajusta los valores. .env no se versiona.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cartilla
DB_USER=root
DB_PASS=

APP_TZ=America/Bogota
# Muestra el detalle de errores (solo en desarrollo).
APP_DEBUG=0

# Contraseña del super administrador (mínimo 8 caracteres). Nunca la subas al repositorio.
SUPERADMIN_CLAVE=
